{
  "name": "@mainframework/dom-signals-metro",
  "version": "0.9.9",
  "description": "Metro transformer for @mainframework/signals Workflow A",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mainframework-com/signals-plugins.git",
    "directory": "mainframework-dom-signals-metro"
  },
  "bugs": {
    "url": "https://github.com/mainframework-com/signals-plugins/issues"
  },
  "homepage": "https://github.com/mainframework-com/signals-plugins/tree/master/mainframework-dom-signals-metro#readme",
  "author": "Terry Slack",
  "license": "MIT",
  "keywords": ["typescript", "signals", "metro", "dom-signals"],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "vendor/dom-signals-core", "LICENSE", "README.md"],
  "scripts": {
    "prepare": "husky",
    "clean": "rimraf dist",
    "lint": "pnpm --dir ../mainframework-dom-signals-core run build && node ../mainframework-dom-signals-core/scripts/copy-dist.mjs vendor/dom-signals-core && eslint . --max-warnings=0 --fix",
    "lint-staged": "lint-staged",
    "prebuild": "pnpm clean && pnpm --dir ../mainframework-dom-signals-core run build && node ../mainframework-dom-signals-core/scripts/copy-dist.mjs vendor/dom-signals-core",
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm --dir ../mainframework-dom-signals-core run build && node ../mainframework-dom-signals-core/scripts/copy-dist.mjs vendor/dom-signals-core && vitest run --coverage"
  },
  "lint-staged": {
    "*.(ts|tsx)": ["eslint --fix", "prettier --write"]
  },
  "dependencies": {
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.6"
  },
  "peerDependencies": {
    "@mainframework/signals": "^4.0.2",
    "metro": ">=0.87.1",
    "metro-react-native-babel-transformer": ">=0.77.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "metro-react-native-babel-transformer": "^0.77.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
